  m_text: "1\uFF09\u672C\u5173\u4E2D\u7684\u654C\u4EBA\u4E3A\u5927\u738B\uFF0C\u4F60\u4E0D\u518D\u9700\u8981\u731C\u6D4B\u654C\u4EBA\u8EAB\u4EFD\uFF0C\u800C\u662F\u76F4\u9762\u6700\u540E\u7684\u6076\u9B54\t\t\t\t\n2\uFF09\u6BD4\u724C\u89C4\u5219\u4ECD\u7136\u4E0E\u524D\u9762\u7684\u5173\u5361\u4E00\u81F4\t\n\ti\uFF09\u6BCF\u8F6E\u4F60\u4F1A\u83B7\u5F97<color=#FFFF99>7</color>\u5F20\u724C\uFF0C\u4F60\u9700\u8981\u6309\u7167<color=#FFFF99>1,1,2,3</color>\u7684\u65B9\u5F0F\u53BB\u5206\u914D\u81EA\u5DF1\u7684\u724C\u5E76\u53CD\u6263\u5728\u684C\u9762\u4E0A\uFF0C\u5E76\u4E14\n\t\u4F7F\u7528\u9053\u5177\u4E0E\u4E0B\u6CE8\n\tii\uFF09\u7B79\u7801\u4E0E\u9053\u5177\u724C\u53EA\u80FD\u5728\u73A9\u5BB6\u5F00\u724C\u524D\u5206\u914D\uFF0C\u9053\u5177\u724C\u6709cost\u9650\u5236\n\tiii\uFF09\u654C\u6211\u65B9\u786E\u8BA4\u540E\u4F9D\u6B21\u5F00\u724C\u6BD4\u5927\u5C0F\n\t\ta\uFF09\u7B2C\u4E00\u624B<color=#FFFF99>\u6BD4\u5927</color>\uFF0C\u8D62\u5BB6\u8BB01\u5206\t\n\t\tb\uFF09\u7B2C\u4E8C\u624B<color=#FFFF99>\u6BD4\u5C0F</color>\uFF0C\u8D62\u5BB6\u8BB01\u5206\n\t\tc\uFF09\u7B2C\u4E09\u624B<color=#FFFF99>\u6BD42\u5F20\u724C\u548C</color>\uFF0C\u6700\u63A5\u8FD118\u5206\u5373\u4E3A\u8D62\uFF0C\u82E5\u8D85\u8FC718\u5219\u548C\u7B970\uFF0C\u8D62\u5BB6\u8BB02\u5206\n\t\td\uFF09\u7B2C\u56DB\u624B<color=#FFFF99>\u6BD4\u724C\u578B\u5927\u5C0F</color>\uFF0C\u8D62\u5BB6\u8BB03\u5206\t\t\t\t\t\t\r\n\tiv\uFF09\u5206\u6570\u591A\u7684\u4E3A\u8D62\u5BB6\uFF0C\u8D62\u53D6\u573A\u4E0A\u7B79\u7801\t"
