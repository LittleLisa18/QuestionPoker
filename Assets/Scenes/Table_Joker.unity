    \u73A9\u5BB61\u80DC\uFF01(+1\u5206)\r\n\u7B2C3\u7EC4: \u73A9\u5BB61\u80DC\uFF01(+2\u5206)\r\n\u7B2C4\u7EC4:
    \u73A9\u5BB61\u80DC\uFF01(+3\u5206)\r\n\r\n===== \u7EC4\u6BD4\u8F83\u8BE6\u60C5
    =====\r\n\u7B2C1\u7EC4: \u5927\u724C\u80DC\r\n\u73A9\u5BB61: \u9ED1\u6843A\r\n\u73A9\u5BB62:
    \u7EA2\u5FC3K\r\n\u7ED3\u679C: \u73A9\u5BB61\u80DC (+1\u5206)\r\n\r\n\u7B2C2\u7EC4:
    \u5C0F\u724C\u80DC\r\n\u73A9\u5BB61: \u7EA2\u5FC32\r\n\u73A9\u5BB62: \u9ED1\u68435\r\n\u7ED3\u679C:
    \u73A9\u5BB61\u80DC (+1\u5206)\r\n\r\n\u7B2C3\u7EC4: \u70B9\u6570\u548C\u5927\u7684\u80DC\r\n\u73A9\u5BB61:
    \u65B9\u5757K, \u6885\u82B1Q\r\n\u73A9\u5BB62: \u6885\u82B1A, \u65B9\u575710\r\n\u70B9\u6570\u548C:
    \u73A9\u5BB61=25, \u73A9\u5BB62=24\r\n\u7ED3\u679C: \u73A9\u5BB61\u80DC (+2\u5206)\r\n\r\n\u7B2C4\u7EC4:
    \u724C\u578B\u5927\u7684\u80DC\r\n\u73A9\u5BB61: \u9ED1\u6843J, \u7EA2\u5FC3J,
    \u65B9\u5757J\r\n\u73A9\u5BB62: \u7EA2\u5FC37, \u65B9\u57578, \u9ED1\u68439\r\n\u624B\u724C\u7C7B\u578B:
    \u73A9\u5BB61=ThreeOfAKind, \u73A9\u5BB62=Straight\r\n\u7ED3\u679C: \u73A9\u5BB61\u80DC
    (+3\u5206)\r\n\r\n"
