--- !u!114 &783523987
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 783523985}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5599099a3e26f71449714a0d8c3d1b66, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 1050792012}
  dialogueBox: {fileID: 1519929076}
  IntroImage: {fileID: 2067901537}
  BossImage: {fileID: 1819526464}
  J1Button: {fileID: 112219972}
  J2Button: {fileID: 559153300}
  J3Button: {fileID: 1811198326}
  J4Button: {fileID: 5027560}
  collectButton: {fileID: 1673612205}
  dialogues:
  - "\u73B0\u5728\u4F60\u53EF\u4EE5\u6839\u636E\u6076\u9B54\u7684\u5462\u5583\u4E0E\u4F60\u6240\u62E5\u6709\u7684\u8D44\u6599\n\u6765\u9009\u62E9\u4E00\u4F4D\u4F60\u8BA4\u4E3A\u7684\u672C\u5173\u4E0E\u4F60\u5BF9\u5C40\u7684\u6076\u9B54\t\t\r\n\u82E5\u6B63\u786E\uFF0C\u6076\u9B54\u73B0\u8EAB\u540E\u4F1A\u53D7\u5230\u91CD\u521B\uFF08Boss\u7684\u521D\u59CB\u7B79\u7801\u6570\u53D8\u5C11\uFF09\t\t\r\n\u82E5\u9519\u8BEF\uFF0C\u4F60\u4F1A\u53D7\u5230\u6076\u9B54\u7684\u8BC5\u5492\uFF08\u76EE\u524D\u6240\u62E5\u6709\u7684\u7B79\u7801\u6570\u53D8\u5C11\uFF09"
  - "\u8BF7\u505A\u51FA\u4F60\u7684\u9009\u62E9\uFF1A"
  correctDialogues:
  - "\u4F60\u9053\u51FA\u4E86\u4ED6\u7684\u540D\u5B57\u3002\u6076\u9B54\u7684\u4F2A\u88C5\u5728\u4F60\u773C\u524D\u5D29\u88C2\uFF0C\u771F\u6B63\u7684\u8EAB\u4EFD\u65E0\u6240\u9041\u5F62"
  - "\u539F\u6765\u5982\u6B64......\u4F60\u5DF2\u770B\u7A7F\u4E86\u6211\u7684\u7075\u9B42\t\t\t\r\n\u65E2\u7136\u5982\u6B64\uFF0C\u4FBF\u8BA9\u6211\u4EE5\u771F\u6B63\u7684\u59FF\u6001\uFF0C\u8D4E\u6E05\u8FD9\u573A\u7F6A\u5B7D\u7684\u8D4C\u5C40\n"
  - "\u6B64\u523B\t\t\t\t\t\r\n\u2014\u2014\u9A91\u58EB\u7684\u50B2\u6162\u5982\u5F71\u968F\u5F62\uFF0C\u543E\u4E4BJ\u724C\uFF0C\u53EF\u4E3A\u738B\u724C\u9A71\u4F7F\u3002\n\uFF08\u4ECE\u672C\u8F6E\u5F00\u59CB\uFF0C\u5170\u65AF\u6D1B\u7279\u53EF\u5C06J\u724C\u5F53A\u724C\u4F7F\u7528\uFF09\t\t\t\t\t"
  - "\u2014\u2014\u5FCF\u6094\u7684\u4F4E\u8BED\u7F20\u7ED5\u4E0D\u7EDD\uFF0C\u5C14\u7B49\u6240\u6301\u4E4B\u5668\uFF0C\u968F\u65F6\u53EF\u80FD\u88AB\u5C01\u9501\u4E8E\u9ED1\u6697\u3002\n\uFF08\u4ECE\u672C\u8F6E\u5F00\u59CB\uFF0C\u73A9\u5BB6\u7684\u9053\u5177\u724C\u6709\u6982\u7387\u88AB\u9650\u5236\u4F7F\u7528\uFF09\t\t\t\t\t\t"
  - "\u2014\u2014\u800C\u547D\u8FD0\u7684\u8FF7\u96FE\uFF0C\u5C06\u65F6\u800C\u906E\u853D\u4F60\u4EEC\u7684\u624B\u724C\uFF0C\u4F7F\u5C14\u7B49\u96BE\u8FA8\u654C\u53CB\u3002\n\uFF08\u4ECE\u672C\u8F6E\u5F00\u59CB\uFF0C\u73A9\u5BB6\u7684\u624B\u724C\u6709\u6982\u7387\u88AB\u906E\u76D6\uFF09\t\t\t\t\t\t"
  - "\u6076\u9B54\u53D7\u5230\u4E86\u91CD\u521B\uFF0C\u4ED6\u7684\u7B79\u7801\u9AA4\u51CF\t\t\t\r\n\u4F46\u4ED6\u4E5F\u56E0\u6B64\u6108\u53D1\u5371\u9669......\u63A5\u4E0B\u6765\u7684\u6218\u6597\uFF0C\u5C06\u66F4\u52A0\u6FC0\u70C8"
  - "\u53EA\u6709\u8D62\u5B8C\u6076\u9B54\u6240\u6709\u7684\u7B79\u7801\uFF0C\u624D\u80FD\u83B7\u5F97\u6700\u7EC8\u7684\u80DC\u5229\n\u90A3\u4E48\uFF0C\u7EE7\u7EED\u6218\u6597\u5427......"
  wrongDialogues:
  - "\u4F60\u8BF4\u51FA\u4E86\u4E00\u4E2A\u9519\u8BEF\u7684\u540D\u5B57\u3002\u6076\u9B54\u5634\u89D2\u6D6E\u73B0\u8BA5\u8BEE\u7684\u5FAE\u7B11\uFF0C\u8BC5\u5492\u968F\u4E4B\u964D\u4E34"
  - "......\u4F60\u8FD8\u4E0D\u591F\u4E86\u89E3\u6211\uFF0C\u51E1\u4EBA\r\n\u771F\u76F8\u4E00\u65E6\u9519\u5931\uFF0C\u4FBF\u53EA\u5269\u4E0B\u75DB\u82E6\u7684\u4EE3\u4EF7"
  - "\u6B64\u523B\t\t\t\t\t\r\n\u2014\u2014\u9A91\u58EB\u7684\u50B2\u6162\u5982\u5F71\u968F\u5F62\uFF0C\u543E\u4E4BJ\u724C\uFF0C\u53EF\u4E3A\u738B\u724C\u9A71\u4F7F\u3002\n\uFF08\u4ECE\u672C\u8F6E\u5F00\u59CB\uFF0C\u5170\u65AF\u6D1B\u7279\u53EF\u5C06J\u724C\u5F53A\u724C\u4F7F\u7528\uFF09\t\t\t\t\t"
  - "\u2014\u2014\u5FCF\u6094\u7684\u4F4E\u8BED\u7F20\u7ED5\u4E0D\u7EDD\uFF0C\u5C14\u7B49\u6240\u6301\u4E4B\u5668\uFF0C\u968F\u65F6\u53EF\u80FD\u88AB\u5C01\u9501\u4E8E\u9ED1\u6697\u3002\n\uFF08\u4ECE\u672C\u8F6E\u5F00\u59CB\uFF0C\u73A9\u5BB6\u7684\u9053\u5177\u724C\u6709\u6982\u7387\u88AB\u9650\u5236\u4F7F\u7528\uFF09\t\t\t\t\t\t"
  - "\u2014\u2014\u800C\u547D\u8FD0\u7684\u8FF7\u96FE\uFF0C\u5C06\u65F6\u800C\u906E\u853D\u4F60\u4EEC\u7684\u624B\u724C\uFF0C\u4F7F\u5C14\u7B49\u96BE\u8FA8\u654C\u53CB\u3002\n\uFF08\u4ECE\u672C\u8F6E\u5F00\u59CB\uFF0C\u73A9\u5BB6\u7684\u624B\u724C\u6709\u6982\u7387\u88AB\u906E\u76D6\uFF09\t\t\t\t\t\t"
  - "\u6076\u9B54\u7684\u7B79\u7801\u6BEB\u53D1\u65E0\u635F\uFF0C\u4F60\u7684\u7B79\u7801\u5374\u88AB\u541E\u566C\u6B86\u5C3D\t\t\r\n\u4F46\u65E0\u8BBA\u5982\u4F55\uFF0C\u4ED6\u5C06\u73B0\u51FA\u771F\u8EAB\t\t\r\n\u63A5\u4E0B\u6765\uFF0C\u5C06\u662F\u547D\u8FD0\u7684\u5206\u754C\t"
  - "\u53EA\u6709\u8D62\u5B8C\u6076\u9B54\u6240\u6709\u7684\u7B79\u7801\uFF0C\u624D\u80FD\u83B7\u5F97\u6700\u7EC8\u7684\u80DC\u5229\n\u90A3\u4E48\uFF0C\u7EE7\u7EED\u6218\u6597\u5427......"
  typingSpeed: 0.05
  isBossSpeaking: 000000010101010000
  isIntroSpeaking: 010101000000000101
  isDone: 0
