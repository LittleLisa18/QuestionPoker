--- !u!114 &1073706097
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1073706094}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1511507dca2c3e44ba638137b08b3100, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cardDealer: {fileID: 196838523}
  dialogueText: {fileID: 1050792012}
  dialogueBox: {fileID: 1519929076}
  jokerImage: {fileID: 1819526464}
  dialogues:
  - "\u4F60\u7EC8\u4E8E\u8D70\u5230\u4E86\u5C3D\u5934......Jack\uFF0CQueen\uFF0CKing\uFF0CAce\u53EA\u662F\u547D\u8FD0\u7684\u524D\u54E8\t\t\t\r\n\u771F\u6B63\u7684\u738B\u8005\uFF0C\u53EA\u6709\u6211"
  - "\u5728\u8FD9\u7247<color=#DC645A>\u7EA2\u8272</color>\u7684\u9886\u57DF\uFF0C\u6240\u6709\u9ED1\u6697\u7686\u5316\u4E3A\u8363\u5149\t\t\t\r\n\u6211\u62BD\u51FA\u7684\u6BCF\u4E00\u5F20\u724C\uFF0C\u90FD\u5C06\u71C3\u70E7\u4E3A<color=#DC645A>\u7EA2</color>\uFF0C\u8C61\u5F81\u7740\u65E0\u53EF\u8FDD\u9006\u7684\u610F\u5FD7\n\uFF08BOSS\u7684\u624B\u724C\u53EA\u6709\u7EA2\u8272\u724C\uFF09"
  - "<color=#000000>\u2663</color>\uFF1F<color=#000000>\u2660</color>\uFF1F \u4E0D\u8FC7\u662F\u6E34\u671B\u6210\u4E3A<color=#DC645A>\u2666</color>\u4E0E<color=#DC645A>\u2665</color>\u7684\u5F71\u5B50\u7F62\u4E86\n\uFF08Boss\u7684<color=#000000>\u2663</color>\u4E0E<color=#000000>\u2660</color>\u4F1A\u8F6C\u5316\u4E3A<color=#DC645A>\u2666</color>\u4E0E<color=#DC645A>\u2665</color>\uFF0C\u8F6C\u6362\u524D\u540E\u70B9\u6570\u4E0D\u53D8\uFF09"
  - "\u6BCF\u5F53<color=#DC645A>\u2665</color>\u6C47\u805A\uFF0C\u547D\u8FD0\u4FBF\u6084\u7136\u8F6C\u5411\t\t\t\t\t\r\n\u2014\u2014\u5F53<color=#DC645A>\u2665</color>\u5FAE\u5F31\uFF0C\u4F60\u5C1A\u53EF\u4E00\u640F\uFF08\u7ED3\u7B97\u65F6\u82E5\u5168\u573A<color=#DC645A>\u2665</color>\u724C<=5\uFF0C\u65E0\u6548\u679C\uFF09\t\n\u2014\u2014\u5F53<color=#DC645A>\u2665</color>\u6E10\u8D77\uFF0C\u543E\u4E4B\u7B79\u7801\u4FBF\u5982\u6D2A\u6D41\u822C\u589E\u52A0\n\uFF08\u7ED3\u7B97\u65F6\u82E5\u672C\u5C40\u5168\u573A5<<color=#DC645A>\u2665</color>\u724C<=8\uFF0CBoss\u7684\u7B79\u7801\u6570\u56DE\u590D300\uFF09"
  - "\u2014\u2014\u5F53<color=#DC645A>\u2665</color>\u5982\u6F6E\u6C50\u7FFB\u6D8C\u65F6\uFF0C\u738B\u5EA7\u53D8\u5F97\u4E0D\u53EF\u52A8\u6447\n\uFF08\u7ED3\u7B97\u65F6\u82E5\u672C\u5C40\u5168\u573A8<<color=#DC645A>\u2665</color>\u724C<=11\uFF0CBoss\u7B79\u7801\u6570\u56DE\u590D600\uFF09\n\u2014\u2014\u5F53<color=#DC645A>\u2665</color>\u6C47\u805A\u5982\u8840\u6D77\uFF0C\u4F60\u5C06\u51E0\u4E4E\u65E0\u6CD5\u64BC\u52A8\u738B\u5EA7\n\uFF08\u7ED3\u7B97\u65F6\u82E5\u672C\u5C40\u5168\u573A<color=#DC645A>\u2665</color>\u724C>11\uFF0CBoss\u7B79\u7801\u6570\u56DE\u590D900\uFF09"
  - "\u800C<color=#DC645A>\u2666</color>\u4E4B\u5149\u82E5\u805A\uFF0C\u5C06\u906E\u853D\u4F60\u7684\u89C6\u91CE\uFF0C\u8BA9\u4F60\u5728\u8FF7\u96FE\u4E2D\u5F77\u5FA8\t\r\n\uFF08\u7ED3\u7B97\u65F6\u82E5\u672C\u5C40\u5168\u573A<color=#DC645A>\u2666</color>\u724C<=5\uFF0C\u65E0\u6548\u679C\uFF1B\n\u82E55<<color=#DC645A>\u2666</color>\u724C<=8\uFF0C\u73A9\u5BB6\u4E0B\u4E00\u8F6E\u624B\u724C\u5C06\u6709\u4E00\u5F20\u4E0D\u53EF\u89C1\uFF1B\n\u82E58<<color=#DC645A>\u2666</color>\u724C<=11\uFF0C\u5219\u6709\u4E24\u5F20\u4E0D\u53EF\u89C1\uFF1B\n\u82E5<color=#DC645A>\u2666</color>\u724C>11\uFF0C\u5219\u6709\u4E09\u5F20\u4E0D\u53EF\u89C1\uFF09"
  - "\u4F46\u4F1F\u5927\u7684\u738B\u8005\uFF0C\u81EA\u7136\u4E5F\u5141\u8BB8\u5BF9\u624B\u7684\u6323\u624E\uFF0C\u4F60\u5C06\u83B7\u5F97\u66F4\u591A\u884C\u52A8\u7684\u673A\u4F1A\uFF0C\u6765\u89C1\u8BC1\u81EA\u5DF1\u7684\u65E0\u529B\uFF08\u73A9\u5BB6\u884C\u52A8\u70B9\u4E0A\u9650+1\uFF09\n\u6765\u5427\uFF0C\u6311\u6218\u771F\u6B63\u7684\u7EC8\u70B9\uFF01\t"
  typingSpeed: 0.05
